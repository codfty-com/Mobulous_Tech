# Runtime
NODE_ENV=production
PORT=4500
APP_NAME=Asset Heaven
APP_BASE_URL=https://mobulous-tech.vercel.app
REQUEST_BODY_LIMIT=1mb

# Use the exact frontend origins that may call the API. Do not use * in production.
CORS_ORIGINS=https://your-frontend.example.com

# MongoDB
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
MONGO_DB_NAME=AssetHeaven

# Authentication (use long, independent random secrets)
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_EXPIRES_IN=180m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d
SKIP_JWT_AUTH_FOR_TESTING=false

# Email OTP delivery
EMAIL_USER=your-smtp-user@example.com
EMAIL_PASS=your-smtp-app-password
OTP_EXPIRY_MINUTES=5

# Google Sign-In; comma-separate multiple web/mobile client IDs
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com

# Provider and cache configuration
MARKET_CACHE_DURATION_MINUTES=2
MUTUAL_FUND_API_BASE_URL=https://api.mfapi.in
MUTUAL_FUND_SCHEME_LIST_CACHE_DURATION_MINUTES=720
MUTUAL_FUND_LATEST_CACHE_DURATION_MINUTES=720
MUTUAL_FUND_HISTORY_CACHE_DURATION_MINUTES=1440
MUTUAL_FUND_HISTORY_DEFAULT_LIMIT=30
MUTUAL_FUND_HISTORY_MAX_LIMIT=5000
MUTUAL_FUND_PROVIDER_TIMEOUT_MS=15000
